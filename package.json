{
  "name": "doremi-op-reis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nx run @doremi/apps-doremi:dev",
    "dev:api": "nx run api:serve",
    "build": "nx run @doremi/apps-doremi:build",
    "preview": "nx run @doremi/apps-doremi:preview",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test --exclude api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:extract": "nx run @doremi/apps-doremi:i18n:extract",
    "graph": "nx graph",
    "structure:check": "node scripts/check-structure.ts",
    "check": "nx run-many -t typecheck lint test --exclude api && pnpm structure:check && pnpm format:check && pnpm i18n:check",
    "test:api": "nx run api:test",
    "i18n:check": "pnpm i18n:extract && git diff --exit-code -- '*.po'",
    "check:all": "pnpm check && pnpm check:api",
    "check:api": "nx run-many -t format-check validate phpstan test -p api --parallel=1"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Doremi op reis — Nx monorepo: React SPA and Symfony API",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  }
}
