# Copy to .env.local. Generate a value with: openssl rand -hex 16
APP_SECRET=

# Cloudflare R2. Create a bucket and an R2 API token with "Object Read & Write" for this bucket only:
# https://developers.cloudflare.com/r2/api/tokens/
# Use https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com if the bucket has the EU jurisdiction.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
