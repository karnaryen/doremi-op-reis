# Committed defaults for the dev environment. No secrets here:
# put APP_SECRET and the R2 keys in .env.local (git ignores it). See .env.local.example.

# A regular expression for the whole "Origin" header (config/packages/nelmio_cors.yaml adds ^ and $).
# Local pages on any port may call the API. The Vite dev server does not need it: it proxies /api.
CORS_ALLOW_ORIGIN='https?://(localhost|127\.0\.0\.1)(:[0-9]+)?'
