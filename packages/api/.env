# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format: https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# serverVersion tells Doctrine which SQL the server understands, so it does not have to ask the server.
# This default is for PHP outside Docker and a PostgreSQL on port 5432 of this computer. We run PHP in Docker:
# there compose.yaml sets DATABASE_URL (host "database"). Port of the Docker database on this computer:
# `docker compose port database 5432`.
# In production the hosting sets it (Neon): never put the real URL in a committed file.
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# CORS_ALLOW_ORIGIN has no default here on purpose: see .env.dev and config/packages/nelmio_cors.yaml.
###< nelmio/cors-bundle ###

###> app/storage ###
# Cloudflare R2 (S3-compatible API). Empty here: the real values go to .env.local (see .env.local.example).
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, or https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# for a bucket with the EU jurisdiction.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
###< app/storage ###

###> symfony/mailer ###
# null://null sends nothing. Docker sets the DSN of the local mail catcher (compose.override.yaml).
# In production the hosting sets the DSN of the email provider: it has a password.
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/invitations ###
# The sender of the invitation emails.
MAILER_FROM="Doremi op reis <no-reply@doremi.localhost>"
# The origin of the SPA: the link in an invitation email starts with it.
APP_FRONTEND_URL=http://localhost:5173
###< app/invitations ###
