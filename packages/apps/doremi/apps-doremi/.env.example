# Copy to .env.local and adjust. Only VITE_* vars are exposed to the client.

# Origin of the API, for example https://api.example.com. Empty in development: the app calls /api
# on its own origin and the Vite dev server proxies it (see vite.config.ts).
VITE_API_BASE_URL=

# Development only, read by vite.config.ts: where the dev server sends /api requests.
# Default: https://localhost. Set it if the API runs on other ports (HTTPS_PORT=8443).
# API_PROXY_TARGET=https://localhost:8443
